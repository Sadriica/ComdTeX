# Maintainer: sadriica <santirodrigmoca@outlook.com>
# Repackages the official .deb release. Do not edit pkgver or the checksums by
# hand: ../update.sh <version> rewrites them and regenerates .SRCINFO.
pkgname=comdtex-bin
pkgver=1.38.1
pkgrel=1
pkgdesc="Desktop Markdown and LaTeX editor for mathematics and science (binary release)"
arch=('x86_64')
url="https://github.com/Sadriica/ComdTeX"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
optdepends=(
  'pandoc-cli: DOCX/Beamer/Typst export and document import'
  'typst: Typst to PDF export'
  'zip: vault backup'
  'git: in-app Git panel'
  'texlive-fontsrecommended: local XeLaTeX compilation'
)
provides=('comdtex')
conflicts=('comdtex')
options=('!strip' '!debug')
noextract=("comdtex_${pkgver}_amd64.deb")
source=("${url}/releases/download/v${pkgver}/comdtex_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Sadriica/ComdTeX/v${pkgver}/LICENSE")
sha256sums=('595a805364295c37db5ad3c9b9c3085567e3faafbde2d5f191668b6b30becdd4'
            '63ca15856a1f908d03636e716fa96e402ec8cd2ae1e05f42b3e9b04a2af80c6b')

package() {
  # The .deb payload mirrors the final filesystem layout.
  bsdtar -xOf "comdtex_${pkgver}_amd64.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  chmod -R go-w "$pkgdir/usr"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
