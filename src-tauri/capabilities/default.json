{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-allow-vault-dir",
    "allow-set-secret",
    "allow-get-secret",
    "allow-delete-secret",
    "opener:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    },
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.dropbox/info.json" },
        { "path": "$HOME/AppData/Local/Dropbox/info.json" },
        { "path": "$HOME/AppData/Roaming/Dropbox/info.json" },
        { "path": "$HOME/Dropbox" },
        { "path": "$HOME/Library/CloudStorage" },
        { "path": "$HOME/Library/CloudStorage/*" },
        { "path": "$HOME/Google Drive" },
        { "path": "$HOME/My Drive" },
        { "path": "$HOME/GoogleDrive" },
        { "path": "$HOME/OneDrive" },
        { "path": "$HOME/OneDrive - Personal" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.dropbox/info.json" },
        { "path": "$HOME/AppData/Local/Dropbox/info.json" },
        { "path": "$HOME/AppData/Roaming/Dropbox/info.json" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/Library/CloudStorage" }
      ]
    },
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "pandoc",   "cmd": "pandoc",   "args": true },
        { "name": "zip",      "cmd": "zip",      "args": true },
        { "name": "git",      "cmd": "git",      "args": true },
        { "name": "tectonic", "cmd": "tectonic", "args": true },
        { "name": "xelatex",  "cmd": "xelatex",  "args": true },
        { "name": "pdflatex", "cmd": "pdflatex", "args": true },
        { "name": "typst",    "cmd": "typst",    "args": true },
        { "name": "opencode", "cmd": "opencode", "args": true },
        { "name": "claude",   "cmd": "claude",   "args": true }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging"
  ]
}
