{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:scope-home-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "pandoc",   "cmd": "pandoc",   "args": true },
        { "name": "zip",      "cmd": "zip",      "args": true },
        { "name": "git",      "cmd": "git",      "args": true },
        { "name": "tectonic", "cmd": "tectonic", "args": true },
        { "name": "xelatex",  "cmd": "xelatex",  "args": true },
        { "name": "pdflatex", "cmd": "pdflatex", "args": true }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
