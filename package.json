{
  "name": "comdtex",
  "private": true,
  "version": "1.29.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint src/ && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "appimage:manual": "bash scripts/build-appimage.sh",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test -c playwright.visual.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "~14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "mermaid": "^12.2.0",
    "monaco-vim": "^0.4.4",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "uuid": "14.0.0",
    "lodash-es": "^4.18.1",
    "katex": "$katex",
    "nanoid": "^3.3.20",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "monaco-editor": "0.55.1",
    "@types/markdown-it": "$@types/markdown-it",
    "@excalidraw/excalidraw": {
      "sass": "^1.80.0"
    }
  }
}
